# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Database (PostgreSQL) ---
# Used by Prisma (Phase 1). Example for local Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/food_delivery?schema=public"

# --- Auth (NextAuth / Auth.js) ---
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
# Base URL of the app. Required by NextAuth in production.
NEXTAUTH_URL="http://localhost:3000"

# --- Maps & traffic-aware ETA (Mapbox) ---
# Server-side token (Directions API for traffic ETA, Phase 4).
MAPBOX_TOKEN=""
# Public token exposed to the browser (map rendering). Safe to be public.
NEXT_PUBLIC_MAPBOX_TOKEN=""
# NOTE: If no Mapbox token is set, the app falls back to a Haversine
# distance / assumed-speed ETA, clearly labeled "estimate (no live traffic)".

# --- Payments / tips (Stripe, test mode) ---
STRIPE_SECRET_KEY=""

# --- Realtime (Socket.IO server) ---
# URL the browser uses to reach the Socket.IO server (Phase 3+).
SOCKET_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
